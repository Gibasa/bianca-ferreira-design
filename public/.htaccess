ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Domínio oficial: https://www.biancaferreiradesign.com (301 a partir de http e de sem-www)
  RewriteCond %{HTTP_HOST} ^biancaferreiradesign\.com$ [NC]
  RewriteRule ^ https://www.biancaferreiradesign.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.biancaferreiradesign\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.biancaferreiradesign.com%{REQUEST_URI} [L,R=301]

  # Endereços antigos, sem idioma (estavam no sitemap anterior)
  RewriteRule ^(cases|politica-de-privacidade|form|form-en)/?$ /pt/$1 [L,R=301]

  RewriteRule ^index\.html$ - [L]

  # Página independente de fotografia (public/fotografia.html), fora do app React
  RewriteRule ^fotografia/?$ fotografia.html [L]

  # Rotas /pt e /en: HTML com <head> de SEO gerado no build (scripts/vite-plugin-seo-pages.js).
  # Só existem em _pages/ as rotas reais; as demais caem no 404 abaixo.
  RewriteRule ^((?:pt|en)(?:/[a-z0-9-]+)*)/?$ _pages/$1.html [L]

  # Qualquer outro endereço que não seja arquivo ou pasta: 404 de verdade
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # HTML sempre revalidado, para cada deploy aparecer na hora
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Imagens, vídeos e fontes de /images: 7 dias
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Arquivos do build com hash no nome (ex.: index-B0LZ6EvV.js), mudam a cada deploy: 1 ano
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|png|jpe?g|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
